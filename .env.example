# Shared between local runs and the AWS deployment.
# Copy to .env and fill in values from the stack outputs `scripts/aws-deploy.sh` prints.
# Load it with `set -a; source .env; set +a` before running `uv run ahpn ...`.

AWS_REGION=us-east-2

# Always use S3 for page images, same as production.
AHPN_STORAGE=s3
AHPN_S3_BUCKET=
AHPN_S3_PREFIX=documents
# Local Compose Postgres on 5433. In AWS, point this at RDS/Aurora.
AHPN_DATABASE_URL=postgresql+psycopg://ahpn:ahpn@localhost:5433/ahpn

AHPN_CHUNK_CHARS=1500
AHPN_CHUNK_OVERLAP=200

# First-pass retrieval: BM25 + Cohere Rerank on Bedrock.
AHPN_RERANK_MODEL=cohere.rerank-v3-5:0
